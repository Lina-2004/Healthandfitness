<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F0F7FF"
    android:padding="32dp">

    <!-- Titre -->
    <TextView
        android:id="@+id/tvTitleResume"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Résumé de l'objectif"
        android:textSize="26sp"
        android:textStyle="bold"
        android:textColor="#00695C"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/tvTimeLabel"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintVertical_chainStyle="packed"
        android:layout_marginBottom="40dp"/>

    <!-- Temps label -->
    <TextView
        android:id="@+id/tvTimeLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Temps prévu :"
        android:textSize="18sp"
        android:textColor="#004D40"
        app:layout_constraintTop_toBottomOf="@id/tvTitleResume"
        app:layout_constraintBottom_toTopOf="@id/tvTimeValue"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Temps value -->
    <TextView
        android:id="@+id/tvTimeValue"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="#00796B"
        android:layout_marginBottom="25dp"
        app:layout_constraintTop_toBottomOf="@id/tvTimeLabel"
        app:layout_constraintBottom_toTopOf="@id/tvDistanceLabel"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Distance label -->
    <TextView
        android:id="@+id/tvDistanceLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Distance prévue :"
        android:textSize="18sp"
        android:textColor="#004D40"
        app:layout_constraintTop_toBottomOf="@id/tvTimeValue"
        app:layout_constraintBottom_toTopOf="@id/tvDistanceValue"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Distance value -->
    <TextView
        android:id="@+id/tvDistanceValue"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="#00796B"
        android:layout_marginBottom="40dp"
        app:layout_constraintTop_toBottomOf="@id/tvDistanceLabel"
        app:layout_constraintBottom_toTopOf="@id/tvMessage"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Message -->
    <TextView
        android:id="@+id/tvMessage"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Objectif enregistré ✔"
        android:textSize="18sp"
        android:textColor="#00695C"
        android:layout_marginBottom="50dp"
        app:layout_constraintTop_toBottomOf="@id/tvDistanceValue"
        app:layout_constraintBottom_toTopOf="@id/btnCloseResume"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Bouton -->
    <Button
        android:id="@+id/btnCloseResume"
        android:layout_width="200dp"
        android:layout_height="wrap_content"
        android:text="Fermer"
        android:textAllCaps="false"
        android:backgroundTint="#40837D"
        android:textColor="#FFFFFF"
        android:padding="14dp"
        app:layout_constraintTop_toBottomOf="@id/tvMessage"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>
