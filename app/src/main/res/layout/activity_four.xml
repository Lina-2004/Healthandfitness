<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root_rel4"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp"
    android:background="#E8F5E9">

    <!-- Titre -->
    <TextView
        android:id="@+id/tvHeader4"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Saisie des données - Évaluation IMC"
        android:textAlignment="center"
        android:textColor="#816F36"
        android:textSize="28sp"
        android:textStyle="bold"
        android:layout_marginTop="12dp" />

    <!-- Carte formulaire -->
    <RelativeLayout
        android:id="@+id/nested_form_4"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/tvHeader4"
        android:layout_marginTop="32dp"
        android:layout_marginHorizontal="8dp"
        android:background="#FFFFFF"
        android:elevation="6dp"
        android:padding="20dp">

        <!-- Nom -->
        <TextView
            android:id="@+id/labelName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Nom"
            android:textColor="#2E7D32"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/labelName"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_edittext"
            android:hint="Ex : Lina"
            android:padding="14dp"
            android:textColor="#1B5E20"
            android:textColorHint="#9E9E9E"
            android:textSize="16sp" />

        <!-- Âge -->
        <TextView
            android:id="@+id/labelAge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/etName"
            android:layout_marginTop="16dp"
            android:text="Âge"
            android:textColor="#2E7D32"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etAge"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/labelAge"
            android:layout_marginTop="6dp"
            android:inputType="number"
            android:background="@drawable/bg_edittext"
            android:hint="Ex : 25"
            android:padding="14dp"
            android:textColor="#1B5E20"
            android:textColorHint="#9E9E9E"
            android:textSize="16sp" />

        <!-- Poids -->
        <TextView
            android:id="@+id/labelWeight"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/etAge"
            android:layout_marginTop="16dp"
            android:text="Poids (kg)"
            android:textColor="#2E7D32"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etWeight"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/labelWeight"
            android:layout_marginTop="6dp"
            android:inputType="numberDecimal"
            android:background="@drawable/bg_edittext"
            android:hint="Ex : 68.5"
            android:padding="14dp"
            android:textColor="#1B5E20"
            android:textColorHint="#9E9E9E"
            android:textSize="16sp" />

        <!-- Taille -->
        <TextView
            android:id="@+id/labelHeight"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/etWeight"
            android:layout_marginTop="16dp"
            android:text="Taille (cm)"
            android:textColor="#2E7D32"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etHeight"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/labelHeight"
            android:layout_marginTop="6dp"
            android:inputType="number"
            android:background="@drawable/bg_edittext"
            android:hint="Ex : 170"
            android:padding="14dp"
            android:textColor="#1B5E20"
            android:textColorHint="#9E9E9E"
            android:textSize="16sp" />

        <!-- Bouton envoyer -->
        <Button
            android:id="@+id/btnSendTo5"
            android:layout_width="220dp"
            android:layout_height="wrap_content"
            android:layout_below="@id/etHeight"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="28dp"
            android:background="@drawable/bg_button_round"
            android:text="📤 Envoyer vers Détails"
            android:textAllCaps="false"
            android:textColor="#FFFFFF" />

        <!-- Bouton retour -->
        <Button
            android:id="@+id/btnBackMain"
            android:layout_width="220dp"
            android:layout_height="wrap_content"
            android:layout_below="@id/btnSendTo5"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_button_round"
            android:text="🏠 Retour à l'accueil"
            android:textAllCaps="false"
            android:textColor="#FFFFFF" />

        <!-- Résultat -->
        <TextView
            android:id="@+id/lblResult"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/btnBackMain"
            android:layout_marginTop="18dp"
            android:textColor="#1B5E20"
            android:textSize="16sp"
            android:textStyle="italic"
            android:gravity="center" />

    </RelativeLayout>

</RelativeLayout>
