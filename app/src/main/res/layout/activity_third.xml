<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="32dp"
    android:background="#E8F5E9">

    <!-- TITRE -->
    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Exercice Respiration"
        android:textSize="28sp"
        android:textStyle="bold"
        android:letterSpacing="0.05"
        android:textColor="#1B4D3E"
        android:layout_marginBottom="70dp" />

    <!-- CERCLE ANIMÉ -->
    <View
        android:id="@+id/breathCircle"
        android:layout_width="180dp"
        android:layout_height="180dp"
        android:background="@drawable/circle_shape"
        android:elevation="10dp"
        android:layout_marginBottom="55dp" />

    <!-- TEXTE INSPIRE / EXPIRE -->
    <TextView
        android:id="@+id/tvInstruction"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Prêt ?"
        android:textSize="24sp"
        android:textColor="#1B4D3E"
        android:layout_marginBottom="40dp" />

    <!-- PROGRESS BAR -->
    <ProgressBar
        android:id="@+id/progressBreathing"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="260dp"
        android:layout_height="12dp"
        android:max="100"
        android:progress="0"
        android:progressTint="#2D9C89"
        android:progressBackgroundTint="#C7E7DF"
        android:scaleY="2"
        android:clipToPadding="true"
        android:layout_marginBottom="60dp" />

    <!-- BOUTON -->
    <Button
        android:id="@+id/btnFinish"
        android:layout_width="220dp"
        android:layout_height="wrap_content"
        android:backgroundTint="#2D9C89"
        android:padding="14dp"
        android:text="J’ai terminé"
        android:textAllCaps="false"
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        android:letterSpacing="0.03"
        android:layout_marginTop="10dp"/>
</LinearLayout>
