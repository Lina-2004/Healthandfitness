<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:gravity="center_horizontal"
    android:background="#E8F5E9">

    <!-- Carte centrale -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="32dp"
        android:elevation="8dp"
        android:layout_marginTop="40dp"
        android:layout_marginBottom="40dp"
        android:gravity="center_horizontal"
        android:clipToOutline="true"
        android:background="@drawable/rounded_card">

        <!-- Icône -->
        <ImageView
            android:id="@+id/waterIcon"
            android:layout_width="88dp"
            android:layout_height="88dp"
            android:layout_marginBottom="18dp"
            android:src="@drawable/ic_water_drop"
            app:tint="#2E73A8" />

        <!-- Titre (aligné Home) -->
        <TextView
            android:id="@+id/txtHydrationStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Rappel d’hydratation"
            android:textColor="#80684E"
            android:textSize="23sp"
            android:textStyle="bold"
            android:layout_marginBottom="26dp" />

        <!-- Bouton principal -->
        <Button
            android:id="@+id/btnStartHydration"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp"
            android:backgroundTint="#2C83C1"
            android:padding="16dp"
            android:text="💧 Démarrer le rappel"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textStyle="bold" />

        <!-- Bouton secondaire -->
        <Button
            android:id="@+id/btnStopHydration"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:backgroundTint="#C8AB5A"
            android:padding="16dp"
            android:text="⏸ Arrêter le rappel"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textStyle="bold" />

    </LinearLayout>

    <!-- Navigation -->
    <Button
        android:id="@+id/btnBackHome"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:backgroundTint="#7AA450"
        android:padding="16dp"
        android:text="⬅ Retour à l’accueil"
        android:textAllCaps="false"
        android:textColor="#FFFFFF"
        android:textStyle="bold" />

</LinearLayout>
