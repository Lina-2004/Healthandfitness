<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F0F7FF"
    android:padding="32dp">

    <!-- Titre -->
    <TextView
        android:id="@+id/tvTitleObjectif"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Objectif du jour"
        android:textSize="26sp"
        android:textStyle="bold"
        android:textColor="#00695C"
        android:layout_marginBottom="32dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/etTime"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintVertical_chainStyle="packed"/>

    <!-- Temps -->
    <EditText
        android:id="@+id/etTime"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:hint="Temps de marche (minutes)"
        android:inputType="number"
        android:padding="14dp"
        android:background="@android:drawable/edit_text"
        android:layout_marginBottom="16dp"
        app:layout_constraintTop_toBottomOf="@id/tvTitleObjectif"
        app:layout_constraintBottom_toTopOf="@id/etDistance"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Distance -->
    <EditText
        android:id="@+id/etDistance"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:hint="Distance à parcourir (km)"
        android:inputType="numberDecimal"
        android:padding="14dp"
        android:background="@android:drawable/edit_text"
        android:layout_marginBottom="32dp"
        app:layout_constraintTop_toBottomOf="@id/etTime"
        app:layout_constraintBottom_toTopOf="@id/btnSendObjectif"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Valider -->
    <Button
        android:id="@+id/btnSendObjectif"
        android:layout_width="200dp"
        android:layout_height="wrap_content"
        android:text="Valider l'objectif"
        android:textAllCaps="false"
        android:backgroundTint="#40837D"
        android:textColor="#FFFFFF"
        android:padding="14dp"
        android:layout_marginBottom="16dp"
        app:layout_constraintTop_toBottomOf="@id/etDistance"
        app:layout_constraintBottom_toTopOf="@id/btnBackMain"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Retour -->
    <Button
        android:id="@+id/btnBackMain"
        android:layout_width="200dp"
        android:layout_height="wrap_content"
        android:text="Retour"
        android:textAllCaps="false"
        android:backgroundTint="#B2DFDB"
        android:textColor="#004D40"
        android:padding="14dp"
        app:layout_constraintTop_toBottomOf="@id/btnSendObjectif"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>
