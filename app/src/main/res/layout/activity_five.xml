<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root_rel5"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp"
    android:background="#E8F5E9">

    <!-- Titre -->
    <TextView
        android:id="@+id/tvHeader5"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Détails utilisateur"
        android:textSize="26sp"
        android:textStyle="bold"
        android:textColor="#816F36"
        android:textAlignment="center"
        android:layout_marginTop="12dp" />

    <!-- Carte informations -->
    <RelativeLayout
        android:id="@+id/nested_display_5"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/tvHeader5"
        android:layout_marginTop="28dp"
        android:layout_marginHorizontal="8dp"
        android:padding="20dp"
        android:background="#FFFFFF"
        android:elevation="6dp">

        <!-- Nom -->
        <TextView
            android:id="@+id/labelNameValue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Nom :"
            android:textColor="#2E7D32"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvNameValue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_toEndOf="@id/labelNameValue"
            android:layout_alignBaseline="@id/labelNameValue"
            android:layout_marginStart="8dp"
            android:text="-"
            android:textColor="#1B5E20" />

        <!-- Âge -->
        <TextView
            android:id="@+id/labelAgeValue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Âge :"
            android:textColor="#2E7D32"
            android:textStyle="bold"
            android:layout_below="@id/labelNameValue"
            android:layout_marginTop="14dp" />

        <TextView
            android:id="@+id/tvAgeValue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_toEndOf="@id/labelAgeValue"
            android:layout_alignBaseline="@id/labelAgeValue"
            android:layout_marginStart="8dp"
            android:text="-"
            android:textColor="#1B5E20" />

        <!-- Poids -->
        <TextView
            android:id="@+id/labelWeightValue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Poids (kg) :"
            android:textColor="#2E7D32"
            android:textStyle="bold"
            android:layout_below="@id/labelAgeValue"
            android:layout_marginTop="14dp" />

        <TextView
            android:id="@+id/tvWeightValue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_toEndOf="@id/labelWeightValue"
            android:layout_alignBaseline="@id/labelWeightValue"
            android:layout_marginStart="8dp"
            android:text="-"
            android:textColor="#1B5E20" />

        <!-- Taille -->
        <TextView
            android:id="@+id/labelHeightValue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Taille (cm) :"
            android:textColor="#2E7D32"
            android:textStyle="bold"
            android:layout_below="@id/labelWeightValue"
            android:layout_marginTop="14dp" />

        <TextView
            android:id="@+id/tvHeightValue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_toEndOf="@id/labelHeightValue"
            android:layout_alignBaseline="@id/labelHeightValue"
            android:layout_marginStart="8dp"
            android:text="-"
            android:textColor="#1B5E20" />

        <!-- IMC -->
        <TextView
            android:id="@+id/labelBMI"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="IMC :"
            android:textColor="#2E7D32"
            android:textStyle="bold"
            android:layout_below="@id/labelHeightValue"
            android:layout_marginTop="14dp" />

        <TextView
            android:id="@+id/tvBMIValue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_toEndOf="@id/labelBMI"
            android:layout_alignBaseline="@id/labelBMI"
            android:layout_marginStart="8dp"
            android:text="-"
            android:textColor="#1B5E20"
            android:textStyle="bold"
            android:textSize="16sp" />

        <!-- Recommandation -->
        <TextView
            android:id="@+id/tvRecommendation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/labelBMI"
            android:layout_marginTop="20dp"
            android:text="Recommandation : -"
            android:textStyle="italic"
            android:textColor="#33691E" />

        <!-- Bouton fermer -->
        <Button
            android:id="@+id/btnClose5"
            android:layout_width="200dp"
            android:layout_height="wrap_content"
            android:layout_below="@id/tvRecommendation"
            android:layout_marginTop="26dp"
            android:layout_centerHorizontal="true"
            android:background="@drawable/bg_button_round"
            android:text="Fermer"
            android:textAllCaps="false"
            android:textColor="#FFFFFF" />

    </RelativeLayout>

</RelativeLayout>
